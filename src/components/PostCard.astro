---
import type { CollectionEntry } from "astro:content";
import { toPlainTextExcerpt } from "../utils/summary";
import { getPostDescription } from "../utils/posts";
import { slugifyTag } from "../utils/tags";
import { formatDate, toISODate } from "../utils/date";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const formattedDate = formatDate(post.data.date);
const isoDate = toISODate(post.data.date);

// 為了確保摘要穩定且有語意，使用統一的 getPostDescription 抓取邏輯，再轉成純文字摘要。
const summary = toPlainTextExcerpt(getPostDescription(post));
---

<article
  class="group relative flex flex-col justify-between glass-panel glass-panel-hover rounded-2xl p-6 md:p-8 transition-transform duration-300 hover:-translate-y-1">
  <div
    class="absolute inset-0 z-0 bg-gradient-to-br from-violet-500/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 rounded-2xl pointer-events-none">
  </div>

  <div class="relative z-10">
    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 mb-4">
      <time datetime={isoDate} class="font-mono">
        {formattedDate}
      </time>
      <div class="h-1 w-1 rounded-full bg-slate-600"></div>
      {
        post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.slice(0, 3).map((tag) => (
              <span class="text-violet-300">#{tag}</span>
            ))}
          </div>
        )
      }
    </div>

    <h2
      class="font-display text-2xl font-bold text-white mb-3 tracking-tight group-hover:text-violet-200 transition-colors">
      <a
        href={`/posts/${post.slug}/`}
        class="focus:outline-none focus:underline underline-offset-4 decoration-violet-500/50">
        <span class="absolute inset-0" aria-hidden="true"></span>
        {post.data.title}
      </a>
    </h2>

    {
      summary && (
        <p class="text-slate-400 text-sm leading-7 line-clamp-3 mb-4">
          {summary}
        </p>
      )
    }
  </div>

  <div
    class="relative z-10 mt-4 flex items-center text-sm font-medium text-violet-300 transition-colors group-hover:text-violet-200">
    閱讀文章
    <svg
      class="ml-2 size-4 transition-transform group-hover:translate-x-1"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
    </svg>
  </div>
</article>
