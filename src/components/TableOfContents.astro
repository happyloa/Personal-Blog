---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// 只顯示 h2 和 h3 層級的標題
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  filteredHeadings.length > 0 && (
    <>
      {/* 桌面版：固定在右側，捲動時半透明，hover 時恢復 */}
      <aside
        id="toc-desktop"
        class="hidden lg:block fixed top-24 right-4 xl:right-8 w-56 xl:w-64 max-h-[calc(100vh-8rem)] overflow-y-auto opacity-0 translate-x-4 transition-all duration-300 z-40"
        aria-label="文章目錄"
      >
        <nav
          id="toc-nav"
          class="rounded-xl border border-white/10 bg-slate-900/90 p-4 backdrop-blur-md shadow-xl transition-opacity duration-300"
        >
          <p class="mb-3 flex items-center gap-2 text-sm font-medium text-slate-300">
            <svg
              class="size-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 6h16M4 12h16M4 18h7"
              />
            </svg>
            目錄
          </p>
          <ol class="space-y-1 text-sm">
            {filteredHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "ml-4" : ""}>
                <a
                  href={`#${heading.slug}`}
                  class="toc-link relative block py-1 text-slate-400 transition-all duration-200 hover:text-sky-300 no-underline"
                  data-slug={heading.slug}
                >
                  <span class="toc-link-text">{heading.text}</span>
                  <span class="toc-link-underline absolute bottom-0 left-0 h-0.5 w-0 bg-sky-400 transition-all duration-300" />
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      {/* 行動版：浮動按鈕 + 彈出選單 */}
      <div class="lg:hidden">
        {/* 半透明背景遮罩 */}
        <div
          id="toc-overlay"
          class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-40"
          aria-hidden="true"
        />

        {/* 彈出式 TOC */}
        <nav
          id="toc-mobile"
          class="fixed bottom-20 right-4 w-72 max-h-[60vh] overflow-y-auto rounded-xl border border-white/10 bg-slate-900/95 p-4 backdrop-blur-md shadow-2xl opacity-0 scale-95 pointer-events-none transition-all duration-300 origin-bottom-right z-50"
          aria-label="文章目錄"
          aria-hidden="true"
        >
          <p class="mb-3 flex items-center gap-2 text-sm font-medium text-slate-300">
            <svg
              class="size-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 6h16M4 12h16M4 18h7"
              />
            </svg>
            目錄
          </p>
          <ol class="space-y-1 text-sm">
            {filteredHeadings.map((heading) => (
              <li class={heading.depth === 3 ? "ml-4" : ""}>
                <a
                  href={`#${heading.slug}`}
                  class="toc-link-mobile relative block py-1.5 text-slate-400 transition-all duration-200 hover:text-sky-300 no-underline"
                  data-slug={heading.slug}
                >
                  <span class="toc-link-text">{heading.text}</span>
                  <span class="toc-link-underline absolute bottom-0 left-0 h-0.5 w-0 bg-sky-400 transition-all duration-300" />
                </a>
              </li>
            ))}
          </ol>
        </nav>

        {/* FAB 按鈕 */}
        <button
          id="toc-fab"
          type="button"
          class="fixed bottom-4 right-4 size-12 rounded-full bg-sky-500 text-white shadow-lg shadow-sky-500/30 flex items-center justify-center transition-all duration-300 hover:bg-sky-400 hover:scale-105 active:scale-95 z-50"
          aria-label="開啟目錄"
          aria-expanded="false"
        >
          <svg
            id="toc-fab-icon-open"
            class="size-5 transition-all duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h7"
            />
          </svg>
          <svg
            id="toc-fab-icon-close"
            class="size-5 absolute opacity-0 rotate-90 transition-all duration-300"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>

      <style>
        /* 當前標題的下底線效果 */
        .toc-link.active .toc-link-underline,
        .toc-link-mobile.active .toc-link-underline {
          width: 100%;
        }

        .toc-link.active,
        .toc-link-mobile.active {
          color: rgb(125 211 252); /* sky-300 */
        }

        /* TOC 預設有點透明 */
        #toc-nav {
          opacity: 0.7;
        }

        /* 捲動時 TOC 變更透明 */
        #toc-desktop.is-scrolling #toc-nav {
          opacity: 0.3;
        }

        #toc-desktop:hover #toc-nav {
          opacity: 1;
        }
      </style>

      <script>
        function initTOC() {
          const tocDesktop = document.getElementById("toc-desktop");
          const tocNav = document.getElementById("toc-nav");
          const tocMobile = document.getElementById("toc-mobile");
          const tocOverlay = document.getElementById("toc-overlay");
          const tocFab = document.getElementById("toc-fab");
          const fabIconOpen = document.getElementById("toc-fab-icon-open");
          const fabIconClose = document.getElementById("toc-fab-icon-close");
          const mainContent = document.getElementById("main-content");

          if (!tocDesktop || !mainContent) return;

          let isMobileOpen = false;
          let scrollTimeout: ReturnType<typeof setTimeout> | null = null;

          // 桌面版：使用 Intersection Observer 偵測是否進入文章區域
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  tocDesktop.classList.remove("opacity-0", "translate-x-4");
                  tocDesktop.classList.add("opacity-100", "translate-x-0");
                } else {
                  tocDesktop.classList.add("opacity-0", "translate-x-4");
                  tocDesktop.classList.remove("opacity-100", "translate-x-0");
                }
              });
            },
            { threshold: 0, rootMargin: "-100px 0px -50% 0px" }
          );

          observer.observe(mainContent);

          // 捲動時 TOC 變更透明
          function handleScroll() {
            tocDesktop.classList.add("is-scrolling");

            if (scrollTimeout) {
              clearTimeout(scrollTimeout);
            }

            scrollTimeout = setTimeout(() => {
              tocDesktop.classList.remove("is-scrolling");
            }, 600);
          }

          window.addEventListener("scroll", handleScroll, { passive: true });

          // 行動版：切換 TOC
          function toggleMobileTOC() {
            isMobileOpen = !isMobileOpen;

            if (isMobileOpen) {
              tocMobile?.classList.remove("opacity-0", "scale-95", "pointer-events-none");
              tocMobile?.classList.add("opacity-100", "scale-100", "pointer-events-auto");
              tocMobile?.setAttribute("aria-hidden", "false");
              tocOverlay?.classList.remove("opacity-0", "pointer-events-none");
              tocOverlay?.classList.add("opacity-100", "pointer-events-auto");
              tocFab?.setAttribute("aria-expanded", "true");
              fabIconOpen?.classList.add("opacity-0", "-rotate-90");
              fabIconClose?.classList.remove("opacity-0", "rotate-90");
            } else {
              tocMobile?.classList.add("opacity-0", "scale-95", "pointer-events-none");
              tocMobile?.classList.remove("opacity-100", "scale-100", "pointer-events-auto");
              tocMobile?.setAttribute("aria-hidden", "true");
              tocOverlay?.classList.add("opacity-0", "pointer-events-none");
              tocOverlay?.classList.remove("opacity-100", "pointer-events-auto");
              tocFab?.setAttribute("aria-expanded", "false");
              fabIconOpen?.classList.remove("opacity-0", "-rotate-90");
              fabIconClose?.classList.add("opacity-0", "rotate-90");
            }
          }

          tocFab?.addEventListener("click", toggleMobileTOC);
          tocOverlay?.addEventListener("click", () => {
            if (isMobileOpen) toggleMobileTOC();
          });

          // 點擊連結後關閉行動版 TOC
          document.querySelectorAll(".toc-link-mobile").forEach((link) => {
            link.addEventListener("click", () => {
              if (isMobileOpen) toggleMobileTOC();
            });
          });

          // 設定 active 狀態的輔助函式
          const tocLinks = document.querySelectorAll(".toc-link, .toc-link-mobile");

          function setActiveLink(slug: string) {
            tocLinks.forEach((link) => {
              if (link.getAttribute("data-slug") === slug) {
                link.classList.add("active");
                // 自動捲動 TOC 讓 active 項目保持可見
                link.scrollIntoView({
                  behavior: "smooth",
                  block: "nearest",
                  inline: "nearest",
                });
              } else {
                link.classList.remove("active");
              }
            });
          }

          // 點擊 TOC 連結時立即設定 active
          document.querySelectorAll(".toc-link, .toc-link-mobile").forEach((link) => {
            link.addEventListener("click", () => {
              const slug = link.getAttribute("data-slug");
              if (slug) setActiveLink(slug);
            });
          });

          // 高亮當前閱讀的標題（含下底線動畫）
          const headings = document.querySelectorAll("article h2[id], article h3[id]");

          const headingObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const id = entry.target.id;
                  setActiveLink(id);
                }
              });
            },
            { threshold: 0, rootMargin: "-20% 0px -70% 0px" }
          );

          headings.forEach((heading) => headingObserver.observe(heading));
        }

        // 支援 View Transitions
        document.addEventListener("astro:page-load", initTOC);
      </script>
    </>
  )
}
