---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { slugifyTag } from "../../utils/tags";
import { getPublishedPostsSorted } from "../../utils/posts";
import type { CollectionEntry } from "astro:content";

interface Props {
  displayTag: string;
  posts: CollectionEntry<"posts">[];
}

export async function getStaticPaths() {
  // 只查詢一次，然後將資料傳遞給每個標籤頁面
  const allPosts = await getPublishedPostsSorted();
  const tagData = new Map<
    string,
    { display: string; posts: typeof allPosts }
  >();

  allPosts.forEach((post) => {
    post.data.tags.forEach((tag) => {
      const slug = slugifyTag(tag);
      if (!tagData.has(slug)) {
        tagData.set(slug, { display: tag, posts: [] });
      }
      tagData.get(slug)!.posts.push(post);
    });
  });

  return Array.from(tagData.entries()).map(([slug, data]) => ({
    params: { tag: slug },
    props: { displayTag: data.display, posts: data.posts },
  }));
}

const { displayTag, posts } = Astro.props;
---

<BaseLayout
  title={`#${displayTag} 標籤文章 | Aaron 的部落格`}
  description={`包含 #${displayTag} 標籤的文章彙整`}>
  <section class="grid gap-6">
    <div class="flex items-center gap-3">
      <a href="/" class="text-sm text-sky-200 hover:text-sky-100"
        >← 返回文章彙整</a
      >
      <span class="tag-pill text-sm">#{displayTag}</span>
    </div>
    <div class="grid gap-4">
      {
        posts.length === 0 ? (
          <p class="text-slate-200">目前沒有包含這個標籤的文章。</p>
        ) : (
          <div class="grid grid-cols-1 gap-4">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
