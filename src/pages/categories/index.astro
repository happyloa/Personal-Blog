---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPostsSorted } from "../../utils/posts";
import { categories } from "../../utils/categories";

const posts = await getPublishedPostsSorted();

// 計算每個分類的文章數
const categoryCounts = new Map<string, number>();
posts.forEach((post) => {
  const cat = post.data.category;
  categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
});
---

<BaseLayout
  title="文章分類 — Aaron 的部落格"
  description="依照主題分類瀏覽所有文章">
  <div class="mb-8">
    <a
      href="/"
      class="inline-flex items-center gap-1 text-sm text-slate-400 hover:text-sky-300 transition-colors mb-4">
      ← 返回首頁
    </a>
    <h1 class="text-2xl font-bold text-slate-100 mb-2">文章分類</h1>
    <p class="text-slate-400">選擇你有興趣的主題開始閱讀</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      categories.map((category) => (
        <a
          href={`/categories/${category.slug}/`}
          class="group block p-6 rounded-xl bg-slate-800/50 border border-slate-700/50 hover:border-sky-500/50 hover:bg-slate-800 transition-all">
          <div class="text-3xl mb-3">{category.icon}</div>
          <h2 class="text-lg font-semibold text-slate-100 group-hover:text-sky-300 transition-colors mb-1">
            {category.name}
          </h2>
          <p class="text-sm text-slate-400 mb-3">{category.description}</p>
          <span class="text-xs text-slate-500">
            {categoryCounts.get(category.slug) || 0} 篇文章
          </span>
        </a>
      ))
    }
  </div>
</BaseLayout>
