---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { categories } from "../utils/categories";
import { getPublishedPostsSorted } from "../utils/posts";
import { site } from "../utils/site";
import { slugifyTag } from "../utils/tags";

const posts = await getPublishedPostsSorted();

const tagMap = new Map<
  string,
  { count: number; display: string; slug: string }
>();

const categoryCounts = new Map<string, number>();

posts.forEach((post) => {
  categoryCounts.set(
    post.data.category,
    (categoryCounts.get(post.data.category) || 0) + 1,
  );

  post.data.tags.forEach((tag) => {
    const slug = slugifyTag(tag);
    const current = tagMap.get(slug) ?? { count: 0, display: tag, slug };
    tagMap.set(slug, { ...current, count: current.count + 1 });
  });
});

const topTags = Array.from(tagMap.values())
  .sort((a, b) => b.count - a.count)
  .slice(0, 8);
---

<BaseLayout title={site.title} description={site.description}>
  <div class="grid gap-16">
    <section class="max-w-3xl">
      <p class="eyebrow mb-5">Frontend / Web / Notes</p>
      <h1 class="mb-6 text-4xl leading-tight md:text-6xl">
        寫下前端開發、網站架構與學習路上的實作筆記。
      </h1>
      <p class="max-w-2xl text-lg leading-8 text-slate-400">
        這裡整理我在 Vue、React、效能優化、SEO、網路基礎與專案開發中踩過的坑。
        內容以實務經驗為主，也保留一些學習過程中的直覺和反思。
      </p>
    </section>

    <section>
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow mb-2">Categories</p>
          <h2 class="text-2xl">文章分類</h2>
        </div>
        <a href="/categories/" class="text-sm font-medium no-underline">
          查看全部 →
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((category) => (
            <a
              href={`/categories/${category.slug}/`}
              class="surface surface-hover block p-5 no-underline">
              <div class="mb-4 flex items-center justify-between gap-4">
                <span class="text-2xl" aria-hidden="true">{category.icon}</span>
                <span class="font-mono text-xs text-slate-500">
                  {categoryCounts.get(category.slug) || 0} 篇
                </span>
              </div>
              <h3 class="mb-2 text-lg">{category.name}</h3>
              <p class="text-sm leading-6 text-slate-400">
                {category.description}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <section>
      <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="eyebrow mb-2">Tags</p>
          <h2 class="text-2xl">熱門標籤</h2>
        </div>
        <a href="/tags/" class="text-sm font-medium no-underline">
          標籤索引 →
        </a>
      </div>

      <div class="flex flex-wrap gap-2">
        {
          topTags.map((tag) => (
            <a
              href={`/tags/${tag.slug}/`}
              class="tag-pill"
              aria-label={`查看 #${tag.display} 標籤的 ${tag.count} 篇文章`}>
              #{tag.display}
              <span class="ml-1 text-slate-600">{tag.count}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section>
      <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="eyebrow mb-2">Latest</p>
          <h2 class="text-2xl">最新文章</h2>
        </div>
        <a href="/rss.xml" class="text-sm font-medium no-underline">
          RSS 訂閱 →
        </a>
      </div>

      <div class="grid gap-4">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </div>
</BaseLayout>
