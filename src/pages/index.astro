---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPostsSorted } from "../utils/posts";
import { slugifyTag } from "../utils/tags";
import { categories } from "../utils/categories";

const posts = await getPublishedPostsSorted();

// 計算各標籤的文章數量
const tagMap = new Map<
  string,
  { count: number; display: string; slug: string }
>();
posts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    const slug = slugifyTag(tag);
    const current = tagMap.get(slug) ?? { count: 0, display: tag, slug };
    tagMap.set(slug, { ...current, count: current.count + 1 });
  });
});

// 取前 5 個熱門標籤
const topTags = Array.from(tagMap.values())
  .sort((a, b) => b.count - a.count)
  .slice(0, 5);

// 計算每個分類的文章數
const categoryCounts = new Map<string, number>();
posts.forEach((post) => {
  const cat = post.data.category;
  categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
});
---

<BaseLayout
  title="Aaron 的部落格"
  description="用 Astro 打造、部署到 Cloudflare Pages 的全新部落格">
  <div class="space-y-16">
    <!-- Intro / Bio (Mini) -->
    <section>
      <h1
        class="font-display text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
        探索 <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-cyan-400"
          >前端技術</span
        > 與 <br class="hidden sm:block" />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-violet-400"
          >現代化網站架構</span
        > 的旅程
      </h1>
      <p class="text-lg text-slate-400 max-w-2xl leading-relaxed">
        這裡是我記錄技術筆記的地方。從 Vue / React 框架實戰，到 Design System
        建立與效能優化，分享那些在開發路上踩過的坑與學到的事。
      </p>
    </section>

    <!-- 專欄導航 -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="font-display text-2xl font-bold text-white">專欄導航</h2>
        <a
          href="/categories/"
          class="group inline-flex items-center gap-1 text-sm font-medium text-slate-400 hover:text-violet-300 transition-colors">
          查看全部
          <svg
            class="size-4 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-5 gap-4">
        {
          categories.map((category) => (
            <a
              href={`/categories/${category.slug}/`}
              class="group relative flex flex-col items-center justify-center p-6 rounded-2xl glass-panel glass-panel-hover transition-transform hover:-translate-y-1">
              <div class="text-3xl mb-3 group-hover:scale-110 transition-transform duration-300 drop-shadow-[0_0_15px_rgba(124,58,237,0.3)]">
                {category.icon}
              </div>
              <h3 class="font-display text-sm font-bold text-slate-200 group-hover:text-white transition-colors">
                {category.name}
              </h3>
              <p class="text-xs text-slate-500 mt-1 font-mono">
                {categoryCounts.get(category.slug) || 0}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 熱門標籤區塊 -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <h2 class="font-display text-2xl font-bold text-white">熱門標籤</h2>
        <div class="h-px flex-1 bg-white/10"></div>
      </div>
      <div class="flex flex-wrap gap-3">
        {
          topTags.map((tag) => (
            <a
              href={`/tags/${tag.slug}/`}
              class="tag-pill px-4 py-2 text-sm"
              aria-label={`查看 #${tag.display} 標籤的 ${tag.count} 篇文章`}>
              #{tag.display}
              <span class="ml-1 opacity-60">({tag.count})</span>
            </a>
          ))
        }
        <a
          href="/tags/"
          class="inline-flex items-center gap-1 px-4 py-2 text-sm text-slate-500 hover:text-violet-300 transition-colors">
          更多標籤 →
        </a>
      </div>
    </section>

    <!-- 文章列表 -->
    <section>
      <div class="flex items-center justify-between mb-8">
        <h2 class="font-display text-2xl font-bold text-white">最新文章</h2>
        <a
          href="/rss.xml"
          class="text-slate-500 hover:text-orange-400 transition-colors"
          aria-label="RSS 訂閱">
          <svg class="size-5" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M6.18 15.64a2.18 2.18 0 01-2.18 2.18 2.18 2.18 0 01-2.18-2.18A2.18 2.18 0 014 13.46c1.2 0 2.18.98 2.18 2.18zM4 4.44v3.39c7.03 0 12.73 5.7 12.73 12.73h3.38C20.11 11.36 12.64 4.44 4 4.44zm0 6.78v3.39c3.53 0 6.4 2.86 6.4 6.39h3.38c0-5.4-4.38-9.78-9.78-9.78z"
            ></path></svg
          >
        </a>
      </div>

      <div class="grid gap-6">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  </div>
</BaseLayout>
