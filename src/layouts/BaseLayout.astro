---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import fontsHref from "../styles/fonts.css?url";

const {
  title = "Aaron 的部落格",
  description = "用 Astro 打造、部署到 Cloudflare Pages 的全新部落格",
  image = "/favicon.svg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Aaron 的部落格"
      href="/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <link rel="preload" as="style" href={fontsHref} />
    <link
      rel="stylesheet"
      href={fontsHref}
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-50">
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <div class="relative isolate overflow-hidden">
      <div
        class="absolute inset-0 -z-10 opacity-40"
        aria-hidden="true"
        style="background: radial-gradient(circle at 20% 20%, #7c3aed22, transparent 35%), radial-gradient(circle at 80% 0%, #22d3ee22, transparent 30%), radial-gradient(circle at 70% 80%, #a855f722, transparent 35%);">
      </div>
      <header class="max-w-5xl mx-auto px-3 md:px-6 py-10 flex flex-col gap-6">
        <a href="/" class="inline-flex items-center gap-3 group">
          <div
            class="h-11 w-11 rounded-2xl bg-linear-to-br from-sky-400 to-violet-500 flex items-center justify-center text-xl font-bold shadow-lg shadow-violet-500/30">
            A
          </div>
          <div>
            <p class="text-lg font-semibold leading-tight text-white">
              Aaron 的部落格
            </p>
            <p class="text-sm text-slate-300">
              用 Astro + Tailwind 重啟的新基地
            </p>
          </div>
          <svg
            class="size-5 text-slate-400 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <nav class="flex items-center justify-between" aria-label="主要導覽">
          <div class="flex gap-4 text-sm text-slate-300">
            <a href="/" class="hover:text-white transition">最新文章</a>
            <a href="/tags/" class="hover:text-white transition">標籤索引</a>
          </div>
          <div class="flex items-center gap-3">
            <a
              href="https://github.com/happyloa"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-white transition"
              aria-label="GitHub">
              <svg
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>

            <a
              href="https://www.cake.me/aaron-yumin"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-white transition"
              aria-label="CakeResume">
              <svg
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true">
                <path
                  d="M20 6H4c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 10H4V8h16v8zM6 10h2v4H6zm3 0h6v4H9zm7 0h2v4h-2z"
                ></path>
              </svg>
            </a>
            <a
              href="/rss.xml"
              class="text-slate-400 hover:text-white transition"
              aria-label="RSS 訂閱">
              <svg
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true">
                <path
                  d="M6.18 15.64a2.18 2.18 0 01-2.18 2.18 2.18 2.18 0 01-2.18-2.18A2.18 2.18 0 014 13.46c1.2 0 2.18.98 2.18 2.18zM4 4.44v3.39c7.03 0 12.73 5.7 12.73 12.73h3.38C20.11 11.36 12.64 4.44 4 4.44zm0 6.78v3.39c3.53 0 6.4 2.86 6.4 6.39h3.38c0-5.4-4.38-9.78-9.78-9.78z"
                ></path>
              </svg>
            </a>
          </div>
        </nav>
      </header>
      <main
        id="main-content"
        class="max-w-5xl mx-auto px-3 md:px-6 pb-16"
        tabindex="-1">
        <slot />
      </main>
      <footer
        class="max-w-5xl mx-auto px-3 md:px-6 pb-10 text-sm text-slate-400 border-t border-white/5 pt-8">
        <div class="grid gap-8 sm:grid-cols-3 mb-8">
          <div>
            <h3 class="font-semibold text-white mb-3">網站導覽</h3>
            <ul class="space-y-2">
              <li>
                <a href="/" class="hover:text-sky-300 transition">首頁</a>
              </li>
              <li>
                <a href="/tags/" class="hover:text-sky-300 transition"
                  >標籤索引</a
                >
              </li>
              <li>
                <a href="/rss.xml" class="hover:text-sky-300 transition"
                  >RSS 訂閱</a
                >
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-white mb-3">社群連結</h3>
            <ul class="space-y-2">
              <li>
                <a
                  href="https://github.com/happyloa"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-sky-300 transition">GitHub</a
                >
              </li>

              <li>
                <a
                  href="https://www.cake.me/aaron-yumin"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-sky-300 transition">CakeResume</a
                >
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-white mb-3">關於我</h3>
            <p class="text-slate-400 leading-relaxed">
              具 4 年經驗前端工程師，專精 Vue (Nuxt) / React (Next.js)
              現代化架構與 Node.js 後端整合，擁有 Design-to-Code 跨域協作與
              DevOps (Docker/CI/CD) 部署實戰經驗。曾主導 50+ 專案交付，具備
              TOEIC 895 英語跨國協作能力。
            </p>
          </div>
        </div>
        <div class="pt-6 border-t border-white/5 text-center">
          <p>© {currentYear} Aaron. Powered by Astro & Tailwind CSS</p>
        </div>
      </footer>
    </div>
  </body>
</html>
