---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

const {
  title = "Aaron 的部落格",
  description = "用 Astro 打造、部署到 Cloudflare Pages 的全新部落格",
  image = "/favicon.svg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-Hant" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0C15" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Aaron 的部落格"
      href="/rss.xml"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col relative overflow-x-hidden selection:bg-violet-500/30">
    <a class="skip-link" href="#main-content">跳到主要內容</a>

    <!-- Background Effects -->
    <div class="fixed inset-0 -z-10 pointer-events-none">
      <div
        class="absolute top-0 left-1/4 w-96 h-96 bg-violet-600/20 rounded-full blur-[128px] mix-blend-screen opacity-50 animate-pulse">
      </div>
      <div
        class="absolute bottom-0 right-1/4 w-96 h-96 bg-cyan-600/20 rounded-full blur-[128px] mix-blend-screen opacity-50 animate-pulse delay-1000">
      </div>
    </div>

    <header
      class="sticky top-4 z-50 mx-auto w-full max-w-5xl px-3 md:px-6 mb-12">
      <div
        class="glass-panel rounded-2xl px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div
            class="relative flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-violet-600 to-indigo-600 text-white shadow-lg shadow-violet-500/20 transition-transform duration-300 group-hover:scale-105 group-hover:shadow-violet-500/40">
            <span class="font-display font-bold text-xl">A</span>
            <div class="absolute inset-0 rounded-xl ring-1 ring-white/20"></div>
          </div>
          <div class="hidden sm:block">
            <h1
              class="font-display text-lg font-bold text-white leading-none tracking-tight group-hover:text-violet-200 transition-colors">
              Aaron's Blog
            </h1>
          </div>
        </a>

        <nav class="flex items-center gap-6" aria-label="主要導覽">
          <div class="hidden md:flex gap-6 text-sm font-medium text-slate-400">
            <a href="/" class="hover:text-white transition-colors">最新文章</a>
            <a href="/categories/" class="hover:text-white transition-colors"
              >分類專欄</a
            >
            <a href="/tags/" class="hover:text-white transition-colors"
              >標籤索引</a
            >
          </div>

          <div class="h-5 w-px bg-white/10 hidden md:block"></div>

          <div class="flex items-center gap-4">
            <a
              href="https://github.com/happyloa"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-white transition-colors p-1"
              aria-label="GitHub">
              <svg
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"></path>
              </svg>
            </a>
            <a
              href="https://www.cake.me/aaron-yumin"
              target="_blank"
              rel="noopener noreferrer"
              class="text-slate-400 hover:text-white transition-colors p-1"
              aria-label="CakeResume">
              <svg
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true">
                <path
                  d="M20 6H4c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 10H4V8h16v8zM6 10h2v4H6zm3 0h6v4H9zm7 0h2v4h-2z"
                ></path>
              </svg>
            </a>
            <a
              href="/rss.xml"
              class="text-slate-400 hover:text-white transition-colors p-1"
              aria-label="RSS">
              <svg
                class="size-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true">
                <path
                  d="M6.18 15.64a2.18 2.18 0 01-2.18 2.18 2.18 2.18 0 01-2.18-2.18A2.18 2.18 0 014 13.46c1.2 0 2.18.98 2.18 2.18zM4 4.44v3.39c7.03 0 12.73 5.7 12.73 12.73h3.38C20.11 11.36 12.64 4.44 4 4.44zm0 6.78v3.39c3.53 0 6.4 2.86 6.4 6.39h3.38c0-5.4-4.38-9.78-9.78-9.78z"
                ></path>
              </svg>
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main
      id="main-content"
      class="flex-1 w-full max-w-5xl mx-auto px-3 md:px-6 pb-20"
      tabindex="-1">
      <slot />
    </main>

    <footer
      class="mt-auto border-t border-white/5 bg-slate-950/50 backdrop-blur-sm">
      <div class="max-w-5xl mx-auto px-4 py-6">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
          <!-- Brand -->
          <div class="md:col-span-4 space-y-4">
            <div class="flex items-center gap-3">
              <div
                class="h-8 w-8 rounded-lg bg-gradient-to-br from-violet-600 to-indigo-600 flex items-center justify-center text-white font-bold text-sm">
                A
              </div>
              <span class="font-display text-lg font-bold text-white"
                >Aaron's Blog</span
              >
            </div>
            <p class="text-slate-400 text-sm leading-relaxed">
              專注於現代前端技術、系統架構與開發心得分享。
              <br />
              Powered by Astro & Tailwind CSS.
            </p>
          </div>

          <!-- Links -->
          <nav
            class="md:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-8 text-sm"
            aria-label="頁尾導覽">
            <div>
              <h3 class="font-semibold text-white mb-4">網站導覽</h3>
              <ul class="space-y-3">
                <li>
                  <a
                    href="/"
                    class="text-slate-400 hover:text-sky-300 transition-colors"
                    >最新文章</a
                  >
                </li>
                <li>
                  <a
                    href="/categories/"
                    class="text-slate-400 hover:text-sky-300 transition-colors"
                    >分類專欄</a
                  >
                </li>
                <li>
                  <a
                    href="/tags/"
                    class="text-slate-400 hover:text-sky-300 transition-colors"
                    >標籤索引</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <h3 class="font-semibold text-white mb-4">聯絡我</h3>
              <ul class="space-y-3">
                <li>
                  <a
                    href="https://github.com/happyloa"
                    target="_blank"
                    class="text-slate-400 hover:text-sky-300 transition-colors"
                    >GitHub</a
                  >
                </li>
                <li>
                  <a
                    href="https://www.cake.me/aaron-yumin"
                    target="_blank"
                    class="text-slate-400 hover:text-sky-300 transition-colors"
                    >CakeResume</a
                  >
                </li>
                <li>
                  <a
                    href="/rss.xml"
                    class="text-slate-400 hover:text-sky-300 transition-colors"
                    >RSS 訂閱</a
                  >
                </li>
              </ul>
            </div>
            <section class="col-span-2 sm:col-span-1">
              <h3 class="font-semibold text-white mb-3">關於我</h3>
              <p class="text-slate-400 leading-relaxed">
                謝宗佑 — 具4年經驗前端工程師，專精 Vue (Nuxt) / React (Next.js)
                現代化架構與 Node.js 後端整合，擁有 Design-to-Code 跨域協作與
                DevOps (Docker/CI/CD) 部署實戰經驗。曾主導 50+ 專案交付，具備
                TOEIC 895 英語跨國協作能力。
              </p>
            </section>
          </nav>
        </div>
        <div
          class="mt-8 pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© {currentYear} Aaron's Blog. All rights reserved.</p>
          <p>Designed with ❤️ in Taiwan</p>
        </div>
      </div>
    </footer>

    <script is:inline type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

      function initMermaid() {
        mermaid.initialize({
          startOnLoad: false,
          theme: "dark",
          themeVariables: {
            darkMode: true,
            background: "#1e293b",
            primaryColor: "#7c3aed",
            primaryTextColor: "#f8fafc",
            primaryBorderColor: "#6d28d9",
            lineColor: "#94a3b8",
            secondaryColor: "#22d3ee",
            tertiaryColor: "#334155",
          },
        });

        const keywords = [
          "sequenceDiagram",
          "flowchart ",
          "graph ",
          "classDiagram",
          "stateDiagram",
          "erDiagram",
          "gantt",
          "pie",
          "gitgraph",
        ];
        document.querySelectorAll("pre").forEach((pre) => {
          const text = pre.textContent.trim();
          if (keywords.some((kw) => text.startsWith(kw))) {
            const div = document.createElement("div");
            div.className = "mermaid";
            div.textContent = text;
            pre.replaceWith(div);
          }
        });

        mermaid.run();
      }

      initMermaid();
      document.addEventListener("astro:after-swap", initMermaid);
    </script>
  </body>
</html>
