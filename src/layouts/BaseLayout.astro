---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import fontsHref from "../styles/fonts.css?url";

const {
  title = "Aaron 的部落格",
  description = "用 Astro 打造、部署到 Cloudflare Pages 的全新部落格",
  image = "/favicon.svg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <link rel="preload" as="style" href={fontsHref} />
    <link
      rel="stylesheet"
      href={fontsHref}
      media="print"
      onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-50">
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <div class="relative isolate overflow-hidden">
      <div
        class="absolute inset-0 -z-10 opacity-40"
        aria-hidden="true"
        style="background: radial-gradient(circle at 20% 20%, #7c3aed22, transparent 35%), radial-gradient(circle at 80% 0%, #22d3ee22, transparent 30%), radial-gradient(circle at 70% 80%, #a855f722, transparent 35%);">
      </div>
      <header class="max-w-5xl mx-auto px-3 md:px-6 py-10 flex flex-col gap-6">
        <a href="/" class="inline-flex items-center gap-3 group">
          <div
            class="h-11 w-11 rounded-2xl bg-linear-to-br from-sky-400 to-violet-500 flex items-center justify-center text-xl font-bold shadow-lg shadow-violet-500/30">
            A
          </div>
          <div>
            <p class="text-lg font-semibold leading-tight text-white">
              Aaron 的部落格
            </p>
            <p class="text-sm text-slate-300">
              用 Astro + Tailwind 重啟的新基地
            </p>
          </div>
          <svg
            class="size-5 text-slate-400 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
        <nav class="flex items-center justify-between" aria-label="主要導覽">
          <div class="flex gap-4 text-sm text-slate-300">
            <a href="/" class="hover:text-white transition">最新文章</a>
            <a href="/tags/" class="hover:text-white transition">標籤索引</a>
          </div>
        </nav>
      </header>
      <main
        id="main-content"
        class="max-w-5xl mx-auto px-3 md:px-6 pb-16"
        tabindex="-1">
        <slot />
      </main>
      <footer
        class="max-w-5xl mx-auto px-3 md:px-6 pb-10 text-sm text-slate-400 border-t border-white/5 pt-6">
        <p class="text-center">
          Powered by Astro & Tailwind CSS · 部署至 Cloudflare Pages
        </p>
      </footer>
    </div>
  </body>
</html>
