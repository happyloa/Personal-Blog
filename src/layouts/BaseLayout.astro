---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { navLinks, site } from "../utils/site";
import "../styles/global.css";

const {
  title = site.title,
  description = site.description,
  image = "/og-default.png",
  ogType = "website",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-Hant" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-outfit" />
    <Font cssVariable="--font-jetbrains" />
    <Font cssVariable="--font-noto-tc" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href="/rss.xml"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />
    <meta name="twitter:image:alt" content={title} />

    <slot name="head" />

    <ClientRouter />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <a class="skip-link" href="#main-content">跳到主要內容</a>

    <header class="sticky top-0 z-40 border-b border-border-soft bg-base/90 backdrop-blur">
      <div
        class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-3 no-underline">
          <span
            class="flex size-9 items-center justify-center rounded-md border border-border-soft bg-surface font-display text-base font-semibold text-slate-50">
            {site.name.charAt(0)}
          </span>
          <span class="hidden font-display text-base font-semibold text-slate-50 sm:inline">
            {site.name}
          </span>
        </a>

        <nav class="flex items-center gap-1" aria-label="主要導覽">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-sm font-medium text-slate-400 no-underline hover:bg-surface hover:text-slate-50">
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main
      id="main-content"
      class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-6 lg:py-16"
      tabindex="-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-border-soft bg-base">
      <div class="mx-auto grid w-full max-w-5xl gap-10 px-4 py-10 sm:px-6 md:grid-cols-[1.2fr_1fr_1fr]">
        <section>
          <div class="mb-3 flex items-center gap-3">
            <span
              class="flex size-9 items-center justify-center rounded-md border border-border-soft bg-surface font-display font-semibold text-slate-50">
              {site.name.charAt(0)}
            </span>
            <h2 class="text-lg">{site.name}</h2>
          </div>
          <p class="max-w-sm text-sm leading-6 text-slate-400">
            記錄前端工程、網站效能、專案實作與職涯思考的個人技術筆記。
          </p>
        </section>

        <nav aria-label="頁尾導覽">
          <h2 class="mb-3 text-sm font-semibold text-slate-200">導覽</h2>
          <ul class="grid gap-2 text-sm">
            {
              navLinks.map((link) => (
                <li>
                  <a href={link.href} class="text-slate-400 no-underline">
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li><a href="/rss.xml" class="text-slate-400 no-underline">RSS 訂閱</a></li>
          </ul>
        </nav>

        <section>
          <h2 class="mb-3 text-sm font-semibold text-slate-200">連結</h2>
          <ul class="grid gap-2 text-sm">
            <li>
              <a href={site.githubUrl} target="_blank" rel="noopener noreferrer" class="text-slate-400 no-underline">
                GitHub
              </a>
            </li>
            <li>
              <a href={site.cakeUrl} target="_blank" rel="noopener noreferrer" class="text-slate-400 no-underline">
                CakeResume
              </a>
            </li>
          </ul>
        </section>
      </div>

      <div class="border-t border-border-soft px-4 py-5 text-center text-xs text-slate-400">
        © {currentYear} {site.name}. Built with Astro and Tailwind CSS.
      </div>
    </footer>

    <script>
      import { initMermaid } from "../scripts/mermaid";

      initMermaid();
      document.addEventListener("astro:after-swap", initMermaid);
    </script>
  </body>
</html>
